{
  "name": "instagram-stats",
  "private": true,
  "type": "module",
  "description": "Neon Function (slug igstats): daily Instagram follower + gender snapshot into social_stats.instagram_daily",
  "scripts": {
    "bundle": "esbuild index.ts --bundle --platform=node --target=node24 --format=esm --minify --banner:js=\"import{createRequire as ___cr}from'module';const require=___cr(import.meta.url);\" --outfile=dist/index.mjs",
    "zip": "cd dist && rm -f ../function.zip && zip -q ../function.zip index.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@types/node": "^26.6.3",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
